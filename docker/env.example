# Copy to `.env.docker` in the repo root and fill in real values, then:
#   npm run docker:all
# `.env.docker` is gitignored (matched by `.env.*`) — never commit it.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=urban_service
MYSQL_USER=helpr
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Backend session (min 16 chars; generate with `openssl rand -hex 32`) ---
SESSION_SECRET=

# Extra origins for cross-origin API calls (Capacitor, separate admin hosts).
# Same-origin Docker gateway does not need these for browser SPAs.
ALLOWED_ORIGINS=https://kyndpro.com,https://www.kyndpro.com

# Shared secret required to create an admin account via /api/auth/signup.
ADMIN_SIGNUP_SECRET=

# Bearer token for the recurring-visit dispatcher (min 16 chars, else the
# endpoint stays closed). See DEPLOYMENT_DOCKER.md for the cron entry.
INTERNAL_API_TOKEN=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Airwallex payments ('prod' for live, 'demo' for testing) ---
AIRWALLEX_ENV=prod
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
PAYMENT_CURRENCY=SGD

# --- Public URL prefix (no trailing slash). SPAs + /api + /images live under this. ---
# Production on kyndpro.com: leave empty → https://kyndpro.com/
# Path-prefix host (e.g. shared domain): APP_BASE=/mykynd and VITE_API_BASE=/mykynd/api
APP_BASE=
VITE_API_BASE=/api

# --- Host port mapping ---
WEB_HOST_PORT=8080
MYSQL_HOST_PORT=3307
