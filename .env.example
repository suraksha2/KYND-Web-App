# Copy to `.env` (dev) or `.env.production` (build) and set real values.

# Base URL of the backend API (Express app in ./backend/db), including "/api".
# Development default is http://localhost:3001/api.
# In production set this to your live backend, e.g. https://kyndpro.com/api
VITE_API_BASE=http://localhost:3001/api

# Public site origin (no trailing slash) for SEO canonical, Open Graph, sitemap.
VITE_SITE_URL=https://kyndpro.com
